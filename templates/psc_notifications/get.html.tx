% cascade base { title => $psc.name ~ " personal notifications - Find and update company information - GOV.UK" }
% around content -> {
<script src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.2/jquery.min.js"></script>
<script src='//<% $cdn_url %>/javascripts/vendor/selection-buttons.js'></script> <!-- Needed for new GDS-style radio buttons and checkboxes -->
<script src='//<% $cdn_url %>/javascripts/vendor/application.js'></script>  <!-- Needed for new GDS-style radio buttons and checkboxes -->

    <div id="content" class="content-override"></div>
    <header class="text">
        <h1 class="heading-xlarge" id="psc-name"><% $psc.display_name %></h1>
    </header>

    <div class="notifications">
        <h2 class="heading-medium" id="psc-notifications">
            % if (!defined $psc.total_results || $psc.total_results == 0) {
                There are no notifications for this person with significant control
            % } else {
                Total number of notifications <% $psc.total_results %>
            % }
        </h2>

        % if $psc.date_of_birth {
            <dl style="margin-bottom: 50px;">
                <dt id="psc-date-of-birth-field">Date of birth</dt>
                <dd class="data" id="psc-date-of-birth-value">
                    <% $c.suppressed_date_as_string($psc.date_of_birth) %>
                </dd>
            </dl>
        % }

        <div class="notifications-list">
            % for $psc.notifications -> $notification {
                <div class="notification-<% $~notification.count %>">
                    <h2 class="heading-medium heading-with-border" id="notification-title-<% $~notification.count %>">
                        <a href="/company/<% $notification.notified_to.company_number %>">
                            <% $notification.notified_to.company_name %> (<% $notification.notified_to.company_number %>)
                        </a>
                    </h2>
                    % if $notification.address {
                    <div class="grid-row">
                        <div class="column-full">
                            <dl>
                                <dt id="notification-address-field-<% $~notification.count %>"><% l('Correspondence address') %></dt>
                                <dd class="data" id="notification-address-value-<% $~notification.count %>">
                                    <% $c.address_as_string($notification.address, { include_care_of => 1, title_case_care_of => 1, include_po_box => 1 }) %>
                                </dd>
                            </dl>
                        </div>
                    </div>
                    % }
                    % if $notification.principal_office_address {
                    <div class="grid-row">
                        <div class="column-full">
                            <dl>
                                <dt id="notification-principle-office-address-field-<% $~notification.count %>"><% l('Principal office address') %></dt>
                                <dd class="data" id="notification-principle-office-address-value-<% $~notification.count %>">
                                    <% $c.address_as_string($notification.principal_office_address, { include_care_of => 1, title_case_care_of => 1, include_po_box => 1 }) %>
                                </dd>
                            </dl>
                        </div>
                    </div>
                    % }
                    <!--
                    % if $notification.notified_to.company_status {
                    <div class="grid-row">
                        <dl class="column-third">
                            <dl>
                                <dt id="notification-status-field-<% $~notification.count %>"><% l('Company status') %></dt>
                                <dd class="data" id="notification-status-value-<% $~notification.count %>">
                                    <% $c.cv_lookup('company_status', $notification.notified_to.company_status) %>
                                </dd>
                            </dl>
                        </dl>
                    </div>
                    % }
                    -->
                    <div class="grid-row">
                        % if $notification.notified_on {
                        <div class="column-third">
                            <dl>
                                <dt><% l('Notified on') %></dt>
                                <dd class="data" id="notification-date-value-<% $~notification.count %>">
                                    <% $c.isodate_as_string($notification.notified_on) %>
                                </dd>
                            </dl>
                        </div>
                        % }
                        % if $notification.ceased_on {
                        <div class="column-third">
                            <dl>
                                <dt><% l('Ceased on') %></dt>
                                <dd class="data" id="notification-ceased-on-value-<% $~notification.count %>">
                                    <% $c.isodate_as_string($notification.ceased_on) %>
                                </dd>
                            </dl>
                        </div>
                        % }
                        % if $notification.nationality {
                        <div class="column-third">
                            <dl>
                                <dt><% l('Nationality') %></dt>
                                <dd class="data" id="notification-nationality-value-<% $~notification.count%>">
                                    <% $notification.nationality %>
                                </dd>
                            </dl>
                        </div>
                        % }
                    </div>
                    <div class="grid-row">
                        % if $notification.country_of_residence {
                        <div class="column-third">
                            <dl>
                                <dt><% l('Place of residence') %></dt>
                                <dd class="data" id="notification-residence-value-<% $~notification.count %>">
                                    <% $notification.country_of_residence %>
                                </dd>
                            </dl>
                        </div>
                        % }
                        % if $notification.identity_verification_details {
                        <div class="column-third">
                            <dl>
                                <dt><% l('Identity verification due from') %></dt>
                                <dd class="data" id="notification-ivddf-value-<% $~notification.count%>">
                                    <% $c.isodate_as_string($notification.identity_verification_details.appointment_verification_statement_date) %>
                                </dd>
                            </dl>
                        </div>
                        % }
                        % if $notification.identity_verification_details {
                        <div class="column-third">
                            <dl>
                                <dt><% l('Identity verification due by') %></dt>
                                <dd class="data" id="notification-ivddf-value-<% $~notification.count%>">
                                    <% $c.isodate_as_string($notification.identity_verification_details.appointment_verification_statement_due_on) %>
                                </dd>
                            </dl>
                        </div>
                        % }
                    </div>
                    <div class="grid-row">
                        % if $notification.identification {
                        <div class="column-half">
                            <dl>
                                <dt><% l('Governing law') %></dt>
                                <dd class="data" id="notification-legal-authority-value-<% $~notification.count%>">
                                    <% $notification.identification.legal_authority %>
                                </dd>
                            </dl>
                        </div>
                        % }
                        % if $notification.identification {
                        <div class="column-half">
                            <dl>
                                <dt><% l('Legal form') %></dt>
                                <dd class="data" id="notification-legal-form-value-<% $~notification.count%>">
                                    <% $notification.identification.legal_form %>
                                </dd>
                            </dl>
                        </div>
                        % }
                    </div>
                    <div class="grid-row">
                        % if $notification.identification.place_registered {
                        <div class="column-half">
                            <dl>
                                <dt><% l('Place registered') %></dt>
                                <dd class="data" id="notification-place-registered-value-<% $~notification.count%>">
                                    <% $notification.identification.place_registered %>
                                </dd>
                            </dl>
                        </div>
                        % }
                        % if $notification.identification.registration_number {
                        <div class="column-half">
                            <dl>
                                <dt><% l('Registration number') %></dt>
                                <dd class="data" id="notification-registration-number-value-<% $~notification.count%>">
                                    <% $notification.identification.registration_number %>
                                </dd>
                            </dl>
                        </div>
                        % }
                    </div>
                    % if $notification.identification.country_registered {
                    <div class="grid-row>
                        <div class="column-full">
                            <dl>
                                <dt><% l('Country registered') %></dt>
                                <dd class="data" id="notification-country-registered-value-<% $~notification.count%>">
                                    <% $notification.identification.country_registered %>
                                </dd>
                            </dl>
                        </div>
                    </div>
                    % }
                    % if $notification.natures_of_control {
                    <div class="grid-row">
                        <div class="column-full">
                            <dl>
                                <dt><% l('Nature of control') %></dt>
                                % for $notification.natures_of_control -> $noc {
                                    <dd class="data" id="notification-noc-<% $~notification.count %>-<% $noc %>">
                                        <% $c.psc_lookup($noc, 'short_description') %>
                                    </dd>
                                % }
                            </dl>
                        </div>
                    </div>
                    % }
                </div>
            % }
        </div>
    </div>

    % if $psc.total_results > $paging.entries_per_page {
        <ul class="pager">
            % if $paging.previous_page {
                <li>
                    <a class="page" id="previous-page" href="<% $c.url_for %>?page=<% $paging.previous_page %>">
                        Previous
                    </a>
                </li>
            % }
            % for $paging.page_set -> $page {
                <li>
                    <a class="page" id="page-number-<% $~page.count %>" href="<% $c.url_for %>?page=<% $page %>">
                        % if $paging.current_page_number == $page {
                            <strong><% $page %></strong>
                        % } else {
                            <% $page %>
                        %}
                    </a>
                </li>
            % }
            % if $paging.next_page {
                <li>
                    <a class="page" id="next-page" href="<% $c.url_for %>?page=<% $paging.next_page %>">
                        Next
                    </a>
                </li>
            % }
        </ul>
    % }

%}
